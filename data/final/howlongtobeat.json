  "example": {
    "request": "u=Mozilla/5.0;i=$(curl -sA$u -ehttps://howlongtobeat.com/ https://howlongtobeat.com/api/find/init);t=$(jq -r .token<<<$i);k=$(jq -r .hpKey<<<$i);v=$(jq -r .hpVal<<<$i);jq -nc --arg k $k --arg v $v '{searchType:\"games\",searchTerms:[\"celeste\"],searchPage:1,size:1,searchOptions:{games:{},users:{}},useCache:true}+{($k):$v}'|curl -sA$u -ehttps://howlongtobeat.com/ -Hcontent-type:application/json -Horigin:https://howlongtobeat.com -Hx-auth-token:$t -Hx-hp-key:$k -Hx-hp-val:$v -d@- https://howlongtobeat.com/api/find",
