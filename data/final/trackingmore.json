  "example": {
    "request": "curl -X GET 'https://api.trackingmore.com/v4/trackings/get?tracking_numbers=1Z999AA10123456784&courier_code=ups' -H 'Tracking-Api-Key: YOUR_API_KEY' -H 'Content-Type: application/json'",
