  "example": {
    "request": "curl \"https://api.nal.usda.gov/fdc/v1/foods/search?query=cheddar%20cheese&api_key=YOUR_API_KEY\"",
    "response_snippet": "{\"totalHits\": 50, \"currentPage\": 1, \"totalPages\": 1, \"foods\": [{\"fdcId\": 173410, \"description\": \"Cheese, cheddar\", \"dataType\": \"SR Legacy\", \"foodNutrients\": [...]}]}"
  },
  "use_cases": [
    "search foods by name and get nutrient profiles",
    "look up detailed nutrition facts by FDC ID",
    "compare nutrients across branded products",
    "build meal planners with official USDA nutrient data",
    "validate food composition for dietary apps"
  ],
