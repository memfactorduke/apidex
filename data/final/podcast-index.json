    "response_snippet": "{\"status\":\"true\",\"feeds\":[{\"id\":920666,\"title\":\"Batman University\",\"url\":\"...\"}],\"count\":1,\"query\":\"batman\",\"description\":\"Found matching feeds.\"}"
