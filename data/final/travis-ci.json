  "example": {
    "request": "curl -H \"Travis-API-Version: 3\" -H \"Authorization: token YOUR_API_KEY\" https://api.travis-ci.com/user",
    "response_snippet": "{\"@type\":\"user\",\"id\":12345,\"login\":\"example\",\"name\":\"Example User\",\"email\":\"user@example.com\",\"is_syncing\":false,\"synced_at\":\"2024-01-01T00:00:00Z\"}"
  },
  "use_cases": [
    "get latest build status for a GitHub repository",
    "list recent builds and jobs for a project",
    "trigger a new Travis CI build for a branch",
