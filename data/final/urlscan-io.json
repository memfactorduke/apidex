    "response_snippet": "{\"message\":\"Submission successful\",\"uuid\":\"...\",\"result\":\"https://urlscan.io/result/.../\",\"api\":\"https://urlscan.io/api/v1/result/.../\",\"visibility\":\"public\",\"url\":\"https://example.com\",\"country\":\"US\"}"
  },
