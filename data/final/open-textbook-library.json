  "status": "operational",
  "name": "Open Textbook Library",
  "category": "education-reference",
  "tagline": "Search peer-reviewed open textbooks for higher education.",
  "description": "The Open Textbook Library (University of Minnesota / Open Education Network) is a catalog of peer-reviewed open educational resource textbooks for higher education. It documents a public read-only JSON API: append .json to textbook and subject resource URLs (and related paths) for programmatic metadata access; OpenAPI docs are published at /opentextbooks/api-docs. CSV and MARC downloads are also provided.",
  "base_url": "https://open.umn.edu/opentextbooks",
  "docs_url": "https://open.umn.edu/opentextbooks/discovery",
  "signup_url": null,
  "auth": {
    "type": "none",
    "details": "No authentication required for public API access. All endpoints are publicly accessible without API keys or tokens."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json"
  ],
  "pricing": {
