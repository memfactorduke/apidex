  "example": {
    "request": "curl -s \"https://open.umn.edu/opentextbooks/textbooks.json?q=calculus\"",
    "response_snippet": "{\n  \"data\": [\n    {\n      \"id\": 10,\n      \"title\": \"Calculus\",\n      \"edition_statement\": \"Third Edition\",\n      \"copyright_year\": 1991,\n      \"license\": \"Attribution-NonCommercial-ShareAlike\",\n      \"language\": \"eng\"\n    }\n  ]\n}"
  },
  "use_cases": [
    "search open textbooks by subject or keyword",
    "get textbook metadata including license and authors",
    "list peer-reviewed OER textbooks for a course",
    "find openly licensed alternatives to commercial textbooks"
