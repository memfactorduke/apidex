  "name": "Kitsu",
  "category": "entertainment",
  "tagline": "Anime and manga catalog API with community ratings and library tracking",
  "description": "Kitsu provides a JSON:API for anime, manga, characters, and user libraries. It is used to search titles, fetch metadata, ratings, episodes, and user-related library data for anime and manga applications.",
  "base_url": "https://kitsu.io/api/edge",
  "docs_url": "https://kitsu.docs.apiary.io/",
  "signup_url": "https://kitsu.io/",
  "auth": {
    "type": "oauth2",
    "details": "OAuth2 password grant at POST /api/oauth/token (refresh_token supported); then Authorization: Bearer. Client-credentials and self-service app registration are not implemented (docs supply a shared client_id). Many public catalog GETs work unauthenticated."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "unknown",
    "paid_plans": null
  },
  "rate_limits": "not published",
  "example": {
    "request": "curl -s 'https://kitsu.io/api/edge/anime?filter%5Btext%5D=cowboy%20bebop' -H 'Accept: application/vnd.api+json'",
    "response_snippet": "{\"data\":[{\"id\":\"1\",\"type\":\"anime\",\"attributes\":{\"slug\":\"cowboy-bebop\",\"canonicalTitle\":\"Cowboy Bebop\",\"averageRating\":\"82.39\",\"episodeCount\":26}}],\"meta\":{\"count\":1}}"
  },
  "use_cases": [
    "search anime by title",
