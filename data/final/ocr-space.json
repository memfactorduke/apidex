    "type": "apiKey",
    "details": "API key via apikey header or form field; free key available after signup at ocr.space"
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "25,000 requests/month free (PRO plan has higher limits)",
    "paid_plans": "PRO plans available with higher limits and priority processing"
  },
  "rate_limits": "Free tier: 500 requests/day, 25,000/month; rate limited per IP/key",
  "example": {
    "request": "curl -H \"apikey: YOUR_API_KEY\" -F \"url=https://example.com/image.jpg\" -F \"language=eng\" -F \"isOverlayRequired=false\" https://api.ocr.space/parse/image",
    "response_snippet": "{\"ParsedResults\":[{\"ParsedText\":\"Hello World\",\"TextOverlay\":{\"Lines\":[],\"HasOverlay\":false},\"FileParseExitCode\":1}],\"OCRExitCode\":1,\"IsErroredOnProcessing\":false,\"ProcessingTimeInMilliseconds\":\"312\"}"
  },
  "use_cases": [
    "extract text from uploaded image files",
    "OCR PDF documents to searchable text",
    "multi-language text recognition from screenshots",
    "batch process receipt or invoice images for data entry",
    "convert scanned documents to plain text"
  ],
