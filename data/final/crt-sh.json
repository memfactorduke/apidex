  "name": "crt.sh",
  "category": "security-identity",
  "tagline": "Certificate Transparency log search for SSL/TLS certificates",
  "description": "Public Certificate Transparency (CT) search service that indexes SSL/TLS certificates from CT logs. Developers query by domain, identity, or certificate fingerprint to discover subdomains, track certificate issuance history, and monitor for unexpected certificates\u2014commonly used for recon, inventory, and security monitoring.",
