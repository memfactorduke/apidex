    "paid_plans": null
  },
  "rate_limits": "not published",
  "example": {
    "request": "curl -s \"https://crt.sh/?q=%.example.com&output=json\"",
    "response_snippet": "[{\"issuer_ca_id\":16418,\"issuer_name\":\"C=US, O=Let's Encrypt, CN=Let's Encrypt Authority X3\",\"common_name\":\"www.example.com\",\"name_value\":\"www.example.com\",\"id\":1234567890,\"entry_timestamp\":\"2020-01-15T12:00:00.000\",\"not_before\":\"2020-01-15T00:00:00\",\"not_after\":\"2020-04-14T23:59:59\",\"serial_number\":\"03abc...\"}]"
  },
  "use_cases": [
    "discover subdomains from certificates issued for a domain",
    "list historical SSL/TLS certificates for a hostname",
    "find certificates matching a wildcard or organization name",
    "monitor new certificate issuance for a domain via CT search",
    "look up a certificate by SHA-256 fingerprint or serial"
  ],
