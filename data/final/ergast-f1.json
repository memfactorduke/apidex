    "details": "No authentication required for public API access"
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json",
    "xml"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "Soft limit ~500 requests/hour; hard limit 4 requests/sec per IP (jolpica-f1 / api.jolpi.ca)",
    "paid_plans": null
  },
  "rate_limits": "Soft limit ~500 req/hour; hard limit 4 req/sec per IP (jolpica-f1 host)",
  "example": {
    "request": "curl -s 'https://api.jolpi.ca/ergast/f1/2024/1/results.json'",
    "response_snippet": "{\"MRData\":{\"xmlns\":\"http://ergast.com/mrd/1.5\",\"series\":\"f1\",\"url\":\"http://api.jolpi.ca/ergast/f1/2024/1/results.json\",\"limit\":\"30\",\"offset\":\"0\",\"total\":\"20\",\"RaceTable\":{\"season\":\"2024\",\"round\":\"1\",\"Races\":[{\"season\":\"2024\",\"round\":\"1\",\"raceName\":\"Bahrain Grand Prix\",\"Results\":[{\"number\":\"1\",\"position\":\"1\",\"positionText\":\"1\",\"points\":\"26\",\"Driver\":{\"driverId\":\"max_verstappen\",\"givenName\":\"Max\",\"familyName\":\"Verstappen\"},\"Constructor\":{\"constructorId\":\"red_bull\",\"name\":\"Red Bull\"}}]}]}}}"
  },
  "use_cases": [
    "get Formula 1 race results for a season or round",
    "fetch driver or constructor championship standings",
    "list F1 circuits, drivers, or constructors by season",
    "get qualifying results for a specific Grand Prix",
