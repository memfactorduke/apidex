  "signup_url": "https://api.census.gov/data/key_signup.html",
  "auth": {
    "type": "apiKey",
    "details": "Optional API key as query parameter key=YOUR_API_KEY. Key required for higher rate limits; signup at api.census.gov. Without a key, limited to 500 queries per IP per day."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json"
  ],
  "pricing": {
    "free_tier": true,
