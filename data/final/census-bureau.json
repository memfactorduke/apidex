  },
  "rate_limits": "...",
  "example": {
    "request": "curl \"https://api.census.gov/data/2023/acs/acs1?get=NAME,B01001_001E&for=state:*&key=YOUR_API_KEY\"",
    "response_snippet": "[[\"NAME\",\"B01001_001E\",\"state\"],[\"Alabama\",\"5108468\",\"01\"],[\"Alaska\",\"733406\",\"02\"],[\"Arizona\",\"7431344\",\"04\"]]"
  },
  "use_cases": [
    "get ACS population estimates by state or county",
    "query Decennial Census demographic variables for a geography",
    "look up economic indicators from Economic Census datasets",
    "fetch population estimates time series for US regions",
    "resolve geographic FIPS codes and area names for census geographies"
  ],
