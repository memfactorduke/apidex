    "request": "curl -H \"X-Api-Key: YOUR_API_KEY\" -H \"Accept: application/json\" \"https://api.eppo.int/gd/v2/taxons/taxon/XYLEFA/overview\"",
    "response_snippet": "{\"eppocode\":\"XYLEFA\",\"prefname\":\"Xylella fastidiosa\",\"is_active\":true}"
  },
  "use_cases": [
