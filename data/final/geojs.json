  "example": {
    "request": "curl -s 'https://get.geojs.io/v1/ip/geo.json'",
    "response_snippet": "{\"ip\":\"1.2.3.4\",\"country\":\"United States\",\"country_code\":\"US\",\"city\":\"...\",\"latitude\":\"...\",\"longitude\":\"...\"}"
  },
  "use_cases": [
    "look up country and city for a visitor IP",
    "detect client country in the browser without an API key",
    "localize content or currency by IP geolocation",
    "enrich server logs with geo metadata for an IP"
