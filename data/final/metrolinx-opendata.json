  "example": {
    "request": "curl -sS \"https://api.openmetrolinx.com/OpenDataAPI/api/V1/Stop/NextService/UN?key=YOUR_ACCESS_KEY\" -H \"Accept: application/json\"",
    "response_snippet": "{\"Metadata\":{\"TimeStamp\":\"2026-08-11T14:29:30\",\"ErrorCode\":\"200\",\"ErrorMessage\":\"OK\"},\"NextService\":{\"Lines\":[{\"StopCode\":\"UN\",\"LineCode\":\"LW\",\"LineName\":\"Lakeshore West\",\"ServiceType\":\"T\",\"DirectionCode\":\"LW\",\"DirectionName\":\"LW - Aldershot GO\",\"ScheduledDepartureTime\":\"2026-08-11T14:30:00\",\"ComputedDepartureTime\":\"2026-08-11T14:32:00\"}]}}"
  },
