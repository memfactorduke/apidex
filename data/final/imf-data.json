{
  "id": "imf-data",
  "status": "operational",
  "name": "IMF Data API",
  "category": "government-open-data",
  "tagline": "Macroeconomic and financial statistics from the International Monetary Fund via SDMX.",
  "description": "Official IMF Data Portal API for importing current catalogue datasets through SDMX 2.1 and 3.0. Access is managed through the beta API portal. It covers World Economic Outlook, balance of payments, prices, exchange rates, and other macroeconomic and financial datasets. IFS is no longer a single dataset; its indicators are organized by topic in successor datasets and can be identified with IMF_FLAG where applicable.",
  "base_url": "https://api.imf.org/external/sdmx/2.1",
  "docs_url": "https://data.imf.org/en/Resource-Pages/IMF-API",
  "signup_url": null,
  "auth": {
    "type": "apiKey",
    "details": "No authentication required for public data access. Some endpoints may have rate limiting."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json",
    "xml"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "unknown",
    "paid_plans": null
  },
  "rate_limits": "not published",
  "example": {
    "request": "curl -H \"Ocp-Apim-Subscription-Key: YOUR_IMF_API_KEY\" -H \"Accept: application/json\" \"https://api.imf.org/external/sdmx/3.0/data/dataflow/IMF.RES/WEO/+/USA.NGDP_RPCH.A?startPeriod=2025&endPeriod=2025&format=jsondata\"",
    "response_snippet": "{\"meta\":{\"id\":\"...\",\"prepared\":\"...\"},\"data\":{\"dataSets\":[{\"observations\":{\"0:0:0:0\":[2.1]}}],\"structure\":{\"dimensions\":{\"observation\":[{\"id\":\"TIME_PERIOD\",\"values\":[{\"id\":\"2025\"}]}]}}}}"
  },
  "use_cases": [
    "fetch IFS exchange rates or CPI for a country",
    "pull WEO GDP growth forecasts",
    "query balance of payments time series",
    "list available IMF datasets and dimensions",
    "build economic dashboards with official IMF statistics"
  ],
  "sources": [
    "https://data.imf.org/en/Resource-Pages/IMF-API"
  ],
