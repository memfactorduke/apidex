  "name": "Gutendex",
  "category": "education-reference",
  "tagline": "Project Gutenberg book catalog JSON API",
  "description": "Gutendex is a free REST API that serves Project Gutenberg ebook metadata as JSON, including titles, authors, languages, subjects, download links, and popularity rankings. No API key is required; developers query the public HTTPS endpoint with filters and pagination to search or browse the catalog.",
  "base_url": "https://gutendex.com",
  "docs_url": "https://gutendex.com",
  "signup_url": null,
  "auth": {
    "type": "none",
    "details": "No authentication required. Public HTTPS endpoints accept unauthenticated GET requests."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "Fully free public API; no published request quotas on official docs",
    "paid_plans": null
  },
  "rate_limits": "not published",
  "example": {
    "request": "curl -s \"https://gutendex.com/books/?search=dickens\"",
    "response_snippet": "{\"count\":200,\"next\":\"https://gutendex.com/books/?page=2&search=dickens\",\"previous\":null,\"results\":[{\"id\":98,\"title\":\"A Tale of Two Cities\",\"authors\":[{\"name\":\"Dickens, Charles\",\"birth_year\":1812,\"death_year\":1870}],\"languages\":[\"en\"],\"download_count\":25000}]}"
  },
  "use_cases": [
    "search Project Gutenberg books by title or author",
    "list free ebooks filtered by language or topic",
    "get metadata and download links for a Gutenberg book ID",
    "find popular public-domain books by download count",
    "browse books available in a given format (e.g. EPUB, plain text)"
  ],
