  "rate_limits": "Dev: 60 req/min, 100k calls/month; Startup: 10 req/s, 1M/month; Professional: 20 req/s, 3M/month; Business: 40 req/s, 7M/month. Exceeding a limit returns HTTP 429.",
  "example": {
    "request": "curl -H \"Authorization: Bearer YOUR_API_KEY\" -H \"accept: application/json\" \"https://api.1inch.com/swap/v6.1/1/quote?src=0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE&dst=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48&amount=1000000000000000000\"",
    "response_snippet": "{\"srcToken\":{\"address\":\"0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\",\"symbol\":\"ETH\",\"decimals\":18},\"dstToken\":{\"address\":\"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48\",\"symbol\":\"USDC\",\"decimals\":6},\"dstAmount\":\"<current quote amount>\",\"protocols\":[{\"token\":\"0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\",\"hops\":[{\"part\":100,\"dst\":\"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48\",\"protocols\":[{\"name\":\"UNISWAP_V3\",\"part\":100}]}]}],\"gas\":100000}"
  },
  "use_cases": [
