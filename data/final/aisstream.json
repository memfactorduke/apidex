  "example": {
    "request": "wscat -c wss://stream.aisstream.io/v0/stream -x '{\"APIKey\":\"YOUR_API_KEY\",\"BoundingBoxes\":[[[-90,-180],[90,180]]]}'",
    "response_snippet": "{\"MessageType\":\"PositionReport\",\"MetaData\":{\"MMSI\":123456789,\"ShipName\":\"EXAMPLE\",\"latitude\":37.8,\"longitude\":-122.4,\"time_utc\":\"2024-01-01 12:00:00.000000000 +0000 UTC\"},\"Message\":{\"PositionReport\":{\"UserID\":123456789,\"Latitude\":37.8,\"Longitude\":-122.4,\"Sog\":12.5,\"Cog\":180.0}}}"
  },
  "use_cases": [
    "stream live vessel positions in a geographic bounding box",
