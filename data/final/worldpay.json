    "request": "curl -u YOUR_USERNAME:YOUR_PASSWORD https://try.access.worldpay.com/payments/authorizations -H 'Content-Type: application/vnd.worldpay.payments-v6+json' -H 'Accept: application/vnd.worldpay.payments-v6.hal+json' -d '{\"transactionReference\":\"ref-001\",\"merchant\":{\"entity\":\"YOUR_ENTITY\"},\"instruction\":{\"narrative\":{\"line1\":\"Trading name\"},\"value\":{\"currency\":\"GBP\",\"amount\":100},\"paymentInstrument\":{\"type\":\"card/plain\",\"cardNumber\":\"4444333322221111\",\"cardExpiryDate\":{\"month\":12,\"year\":2035},\"cvc\":\"123\"}}}'",
    "response_snippet": "{\"outcome\":\"authorized\",\"issuer\":{\"authorizationCode\":\"12345A\"},\"paymentInstrument\":{\"type\":\"card/plain+masked\",\"card\":{\"brand\":\"visa\",\"number\":{\"bin\":\"444433\",\"last4Digits\":\"1111\"}}},\"_links\":{\"payments:settle\":{\"href\":\"https://try.access.worldpay.com/payments/settlements/full/...\"}}}"
  },
