    "request": "curl -s -H \"X-Dune-Api-Key: YOUR_API_KEY\" \"https://api.dune.com/api/v1/query/1215383/results\"",
    "response_snippet": "{\"execution_id\":\"...\",\"query_id\":1215383,\"state\":\"QUERY_STATE_COMPLETED\",\"result\":{\"rows\":[...],\"metadata\":{...}}}"
  },
