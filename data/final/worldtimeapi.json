{
  "id": "worldtimeapi",
  "status": "operational",
  "name": "WorldTimeAPI",
  "category": "geo-maps",
  "tagline": "Free public timezone and current time API by IANA zone or IP",
  "description": "WorldTimeAPI is a free public REST service that returns the current local time, UTC offset, DST status, and related timezone metadata for any IANA timezone, for a client IP address, or for a given IP. Responses are JSON (or plain text). No API key is required. The project is community-maintained; capacity and uptime can vary, and heavy automated use is discouraged.",
  "base_url": "https://worldtimeapi.org/api",
  "docs_url": "https://worldtimeapi.org/pages/schema",
  "signup_url": null,
  "auth": {
    "type": "none",
    "details": "No authentication. Public HTTP GET endpoints; no API key or signup required."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json",
    "text"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "Entirely free; no published free-tier quota or paid plans",
    "paid_plans": null
  },
  "rate_limits": "not published (community reports of intermittent rate limiting / capacity issues; heavy automated use discouraged)",
  "example": {
    "request": "curl -s \"https://worldtimeapi.org/api/timezone/America/New_York\"",
    "response_snippet": "{\n  \"abbreviation\": \"EDT\",\n  \"client_ip\": \"203.0.113.10\",\n  \"datetime\": \"2026-08-08T14:30:00.123456-04:00\",\n  \"day_of_week\": 6,\n  \"day_of_year\": 220,\n  \"dst\": true,\n  \"dst_from\": \"2026-03-08T07:00:00+00:00\",\n  \"dst_offset\": 3600,\n  \"dst_until\": \"2026-11-01T06:00:00+00:00\",\n  \"raw_offset\": -18000,\n  \"timezone\": \"America/New_York\",\n  \"unixtime\": 1786204200,\n  \"utc_datetime\": \"2026-08-08T18:30:00.123456+00:00\",\n  \"utc_offset\": \"-04:00\",\n  \"week_number\": 32\n}"
  },
  "use_cases": [
    "get current local time for an IANA timezone",
    "list all available IANA timezone identifiers",
    "resolve client or arbitrary IP address to local time and timezone",
    "check DST status and UTC offset for a region",
    "convert between unixtime and timezone-local datetime metadata"
  ],
