    "free_tier": true,
    "free_tier_limits": "unknown",
    "paid_plans": null
  },
  "rate_limits": "not published",
  "example": {
    "request": "curl -sL https://proxy.golang.org/golang.org/x/text/@v/list",
    "response_snippet": "v0.3.0\nv0.3.1\nv0.3.2"
  },
  "use_cases": [
    "list available versions of a Go module",
    "download a Go module zip for offline analysis",
    "fetch go.mod contents for a specific module version",
    "resolve latest version info for a Go package"
