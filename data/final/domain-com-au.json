  "example": {
    "request": "curl -s -H \"Authorization: Bearer YOUR_API_KEY\" \"https://api.domain.com.au/v1/listings/residential/_search\" -H \"Content-Type: application/json\" -d '{\"listingType\":\"Sale\",\"locations\":[{\"state\":\"NSW\",\"suburb\":\"Sydney\"}],\"pageSize\":1}'",
    "response_snippet": "[{\"type\":\"PropertyListing\",\"listing\":{\"listingType\":\"Sale\",\"id\":2012345678,\"headline\":\"...\",\"priceDetails\":{\"displayPrice\":\"Contact Agent\"},\"propertyDetails\":{\"bedrooms\":3,\"bathrooms\":2,\"state\":\"NSW\",\"suburb\":\"Sydney\"}}}]"
  },
