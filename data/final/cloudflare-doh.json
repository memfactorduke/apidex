  "tagline": "Public DoH resolver for privacy-preserving DNS queries over HTTPS.",
  "description": "Cloudflare's free public DNS over HTTPS (DoH) resolver at cloudflare-dns.com. Clients send DNS queries as HTTPS requests (RFC 8484 binary wire format or JSON) and receive encrypted responses, avoiding cleartext DNS on the network. No account or API key is required for the public 1.1.1.1 DoH endpoints.",
  "base_url": "https://cloudflare-dns.com/dns-query",
  "docs_url": "https://developers.cloudflare.com/1.1.1.1/encryption/dns-over-https/",
  "signup_url": null,
  "auth": {
    "type": "none",
    "details": "No authentication required for the public DoH resolver. Queries are accepted anonymously over HTTPS."
  },
  "https": true,
  "cors": "unknown",
  "formats": [
    "json",
    "binary"
  ],
  "pricing": {
    "free_tier": true,
    "free_tier_limits": "Free public resolver with no published normal-use quota; unusual high-rate or abusive traffic may be rate-limited.",
    "paid_plans": null
  },
  "rate_limits": "not published (fair use; abuse may be rate-limited)",
  "example": {
    "request": "curl -H 'accept: application/dns-json' 'https://cloudflare-dns.com/dns-query?name=example.com&type=A'",
    "response_snippet": "{\"Status\":0,\"TC\":false,\"RD\":true,\"RA\":true,\"AD\":false,\"CD\":false,\"Question\":[{\"name\":\"example.com\",\"type\":1}],\"Answer\":[{\"name\":\"example.com\",\"type\":1,\"TTL\":300,\"data\":\"93.184.216.34\"}]}"
  },
  "use_cases": [
    "resolve a hostname to A/AAAA records over HTTPS",
    "look up MX or TXT records without a local resolver",
    "perform DNSSEC-aware lookups from a backend service",
    "test DoH client integration against Cloudflare's public resolver",
    "query DNS from restricted networks where UDP/53 is blocked"
  ],
