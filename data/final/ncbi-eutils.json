    "free_tier": true,
    "free_tier_limits": "No paid tier. Free public access: 3 req/s without API key; 10 req/s with free API key (NCBI account). No formal volume cap beyond rate limits and usage policies; contact eutilities@ncbi.nlm.nih.gov for higher throughput.",
    "paid_plans": null
  },
  "rate_limits": "Without API key: \u22643 req/s. With free API key: \u226410 req/s (higher by request to eutilities@ncbi.nlm.nih.gov). Limit is request start rate, not concurrency. Multi-UID: use HTTP POST above ~200 UIDs; PubMed/PMC EPost max 10,000. Prefer History for large sets. Abusive IPs may be blocked.",
  "example": {
    "request": "curl \"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pubmed&term=asthma&retmode=json\"",
