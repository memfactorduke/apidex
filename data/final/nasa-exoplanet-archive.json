  "example": {
    "request": "curl \"https://exoplanetarchive.ipac.caltech.edu/TAP/sync?QUERY=select+pl_name,hostname,disc_year+from+pscomppars+where+disc_year>2020&format=json\"",
    "response_snippet": "[{\"pl_name\":\"TOI-1234 b\",\"hostname\":\"TOI-1234\",\"disc_year\":2021}]"
  },
