  "example": {
    "request": "curl -H \"content-type: application/json\" -H \"authorization: YOUR_AUTH_KEY\" -H \"partner-token: YOUR_PARTNER_TOKEN\" \"https://dev-api.carscan.com/v3.0/diag?vin=1GNALDEK9FZ108495&mileage=51000&dtc=p0420\"",
    "response_snippet": "{\"message\":{\"code\":0,\"message\":\"ok\",\"credentials\":\"valid\",\"version\":\"v3.0.0\",\"endpoint\":\"diag\"},\"data\":{\"code\":\"P0420\",\"urgency\":2,\"urgency_desc\":\"Repair immediately if drivability issues are present...\",\"layman_definition\":\"Catalyst System Efficiency Below Threshold (Bank 1)\",\"tech_definition\":\"Catalyst System Low Efficiency (Bank 1)\"}}"
  },
  "use_cases": [
